# Configure these in your hosting control panel; do not commit real values.
APP_ENV=production
APP_URL=https://your-domain.example/africa-trade-os
DB_HOST=localhost
DB_NAME=africa_trade_os
DB_USER=your_database_user
DB_PASS=your_database_password
ATO_RATE_LIMIT_SALT=replace-with-a-long-random-secret
ATO_KYC_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-new-app-password
MAIL_FROM=your-sender@gmail.com
MAIL_FROM_NAME=Africa Trade OS
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_CALLBACK_URL=https://your-domain.example/africa-trade-os/api/mpesa-callback.php
MPESA_ALLOW_SIMULATION=false
